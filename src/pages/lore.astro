---
import WikiLayout from '../layouts/WikiLayout.astro';
import { getArticles, articleUrl } from '../lib/wiki';
const events = (await getArticles()).filter(a => a.data.category === 'Lore');
const dated = events.filter(a => a.data.date).sort((a,b) => (b.data.date ?? '').localeCompare(a.data.date ?? ''));
const undated = events.filter(a => !a.data.date);
---
<WikiLayout title="Lore" description="The stories, events, builds, and memories of mineandcraft.net." section="Lore">
  <header class="page-heading"><span class="page-kicker">OUR SHARED HISTORY</span><h1>Lore</h1><p>Every world has a story. This is ours.</p></header>
  <p class="directory-intro">The first blocks of a new build. An adventure that went slightly off plan. A moment everyone remembers differently. A place for the history we make together.</p>
  {events.length === 0 ? <section class="empty-chronicle"><span class="eyebrow">AN OPEN BOOK</span><h2>The first chapter is still to come.</h2><p>No events or stories have been recorded yet. Until then, meet the <a href="/players/">players</a> who will fill these pages.</p></section> : <div>{dated.map(event => <article class="timeline-entry"><time datetime={event.data.date}>{event.data.date}</time><h2><a href={articleUrl(event.id)}>{event.data.title}</a></h2><p>{event.data.description}</p></article>)}{undated.length > 0 && <section><h2>Stories without a date</h2>{undated.map(event => <article class="timeline-entry"><h3><a href={articleUrl(event.id)}>{event.data.title}</a></h3><p>{event.data.description}</p></article>)}</section>}</div>}
  <div class="lore-links"><div class="lore-link"><h2>People</h2><p><a href="/players/">Meet our players</a> and discover the stories behind their names.</p></div><div class="lore-link"><h2>Places & builds</h2><p>Room for settlements, shared projects, and the builds that become landmarks.</p></div><div class="lore-link"><h2>Moments</h2><p>A home for milestones, adventures, and the little things worth remembering.</p></div></div>
</WikiLayout>
