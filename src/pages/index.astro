---
import WikiLayout from '../layouts/WikiLayout.astro';
import { getArticles, articleUrl } from '../lib/wiki';
const articles = await getArticles();
const players = articles.filter(a => a.data.category === 'Players');
const stories = articles.filter(a => a.data.category === 'Lore').sort((a, b) => (b.data.date ?? '').localeCompare(a.data.date ?? ''));
const newestStory = stories[0];
const guides = [
  { n: '01', title: 'Getting started', id: 'getting-started', text: 'Your first steps, server access, and playing together.' },
  { n: '02', title: 'Homes & teleporting', id: 'travel', text: 'Set a home, return to spawn, and visit a friend.' },
  { n: '03', title: 'Building & gathering', id: 'building', text: 'Timber, cauldron conversions, and helpful tools.' },
  { n: '04', title: 'Graves & recovery', id: 'graves', text: 'Find your grave and get back on your feet.' },
  { n: '05', title: 'Crafting tweaks', id: 'crafting-tweaks', text: 'The recipes that work a little differently here.' },
  { n: '06', title: 'Heads & collectibles', id: 'collectibles', text: 'Mini blocks, mob heads, and treasures from the End.' },
];
---
<WikiLayout title="mineandcraft.net" description="Guides, recipes, players, and lore for mineandcraft.net." home>
  <h1 class="sr-only">mineandcraft.net</h1>
  <nav class="quick-nav" aria-label="Popular wiki sections"><a href="/category/guides/"><span class="quick-symbol" aria-hidden="true">⌘</span><span><strong>Player guides</strong><small>Make yourself at home</small></span></a><a href="/wiki/crafting-tweaks/"><span class="quick-symbol" aria-hidden="true">▦</span><span><strong>Crafting tweaks</strong><small>A few useful changes</small></span></a><a href="/players/"><span class="quick-symbol" aria-hidden="true">♙</span><span><strong>Our players</strong><small>The people behind the blocks</small></span></a><a href="/lore/"><span class="quick-symbol" aria-hidden="true">❧</span><span><strong>Lore</strong><small>Every world has a story</small></span></a></nav>
  <div class="home-columns">
    <div>
      <section class="panel"><div class="panel-title"><h2>Life on the server</h2><a href="/category/guides/">All guides →</a></div><div class="panel-body guide-list">{guides.map(g => <div class="guide-item"><span class="guide-number">{g.n}</span><div><a href={articleUrl(g.id)}>{g.title}</a><p>{g.text}</p></div></div>)}</div><div class="panel-note">A familiar Minecraft world, with a few <a href="/wiki/mods-and-datapacks/">quality-of-life additions</a>.</div></section>
      <section class="panel"><div class="panel-title"><h2>The people of mineandcraft.net</h2><a href="/players/">Meet everyone →</a></div><div class="panel-body"><p class="panel-intro">Every build starts with a player. Here are ours.</p><div class="profile-grid">{players.map(player => <a class="profile-tile" href={articleUrl(player.id)} title={player.data.title}><img src={player.data.image} width="56" height="56" alt={`${player.data.title}'s Minecraft head`} loading="lazy" /><span>{player.data.title}</span></a>)}</div></div></section>
    </div>
    <div>
      <section class="panel"><div class="panel-title sand"><h2>Lore</h2><a href="/lore/">Explore Lore →</a></div><div class="panel-body"><p class="lore-lead">The world is made of blocks.<br />The rest is us.</p><p class="lore-copy">Great builds, unexpected adventures, and the moments that become server history. This is where we keep them.</p>{newestStory ? <div class="lore-mini"><strong><a href={articleUrl(newestStory.id)}>{newestStory.data.title}</a></strong><p>{newestStory.data.description}</p></div> : <div class="lore-mini"><strong>The story is still being written.</strong><p>No events recorded yet. There is plenty of room for a first chapter.</p></div>}<a class="text-link" href="/players/">Start with the people behind the stories →</a></div></section>
    </div>
  </div>
  <aside class="rule-strip"><span class="rule-icon" aria-hidden="true">❧</span><strong>Be civil.</strong><span>A shared world works best when we look out for each other.</span><a href="/wiki/rules/">Our one rule →</a></aside>
</WikiLayout>
