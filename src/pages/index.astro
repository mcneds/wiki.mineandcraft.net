---
import WikiLayout from '../layouts/WikiLayout.astro';
import { getArticles, articleUrl } from '../lib/wiki';
const articles = await getArticles();
const players = articles.filter(a => a.data.category === 'Players');
const guides = [
  { n: '01', title: 'Set a home & teleport', id: 'travel', text: 'Save a location with /trigger sethome, then return with /trigger home.' },
  { n: '02', title: 'Chop trees & convert materials', id: 'building', text: 'Chop a tree with an axe. Drop concrete powder or dirt into a water cauldron to make concrete or mud.' },
  { n: '03', title: 'Recover items from a grave', id: 'graves', text: 'Click your grave to retrieve the items saved when you died.' },
  { n: '04', title: 'Use changed crafting recipes', id: 'crafting-tweaks', text: 'Smelt rotten flesh into leather, turn wool into string, and reclaim blocks from slabs or stairs.' },
  { n: '05', title: 'Make mini blocks & collect heads', id: 'collectibles', text: 'Use a stonecutter to make mini blocks. Killing mobs gives a chance of a head drop.' },
  { n: '06', title: 'Repair Mending equipment', id: 'trading-and-repairs', text: 'Sneak-right-click a Mending item to repair it using experience you already have.' },
  { n: '07', title: 'Plan a build in creative', id: 'creative-planning', text: 'Open /plan to design a build. Each user can have one creative project world.' },
  { n: '08', title: 'Extend a jukebox with speakers', id: 'copper-speakers', text: 'Connect speakers with copper wire to play jukebox music around your build.' },
];
---
<WikiLayout title="mineandcraft.net" description="Guides, recipes, and players for mineandcraft.net." home>
  <h1 class="sr-only">mineandcraft.net</h1>
  <section class="panel"><div class="panel-title"><h2>What's different</h2><a href="/category/guides/">All guides →</a></div><div class="panel-body guide-list">{guides.map(g => <div class="guide-item"><span class="guide-number">{g.n}</span><div><a href={articleUrl(g.id)}>{g.title}</a><p>{g.text}</p></div></div>)}</div></section>
  <section class="panel" aria-labelledby="member-list-title"><div class="panel-title"><h2 id="member-list-title">The people of mineandcraft.net</h2><a href="/players/">Meet everyone →</a></div><div class="panel-body"><div class="profile-grid">{players.map(player => <a class="profile-tile" href={articleUrl(player.id)} title={player.data.title}><img src={player.data.image} width="56" height="56" alt={`${player.data.title}'s Minecraft head`} loading="lazy" /><span>{player.data.title}</span></a>)}</div></div></section>
  <aside class="rule-strip"><strong>Be civil.</strong><span>A shared world works best when we look out for each other.</span><a href="/wiki/rules/">Our one rule →</a></aside>
</WikiLayout>
