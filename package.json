{
  "name": "mineandcraft-wiki",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro sync --force && astro check && astro build && pagefind --site dist && node scripts/check-links.mjs",
    "preview": "astro preview --host 127.0.0.1",
    "deploy": "npm run build && wrangler deploy",
    "test": "playwright test"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.4",
    "astro": "^7.4.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "pagefind": "^1.5.2",
    "typescript": "^5.9.3",
    "wrangler": "^4.152.0"
  }
}
